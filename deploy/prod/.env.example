# 复制为 .env 后填写。这个文件含密钥，不要提交进版本库。

# 解析到本服务器的域名。Caddy 会用它自动申请 Let's Encrypt 证书。
DOMAIN=screen.example.com

# 下发给客户端的公网接入地址。必须与上面的域名一致，且用 wss。
# 原生 App 技术上可以走 ws，但连接密码与令牌会明文过公网，不要这么做。
PUBLIC_LIVEKIT_URL=wss://screen.example.com

# LiveKit 的密钥对。用下面的命令生成随机值，不要沿用示例：
#   openssl rand -hex 16   # 作为 KEY
#   openssl rand -hex 32   # 作为 SECRET
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
