{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteScreen",
  "version": "0.2.12",
  "identifier": "com.remotescreen.rs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RemoteScreen",
        "width": 940,
        "height": 620,
        "resizable": true,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/chat-videos/*.mp4"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "RemoteScreen Dev",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "../../../../config/client-version.json": "update-version.json"
    }
  }
}
